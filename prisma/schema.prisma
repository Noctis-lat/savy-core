generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Profile ──────────────────────────────────────────────────────────
// User profile — linked by authId (UUID from Supabase JWT sub claim)
model Profile {
  id             String   @id @default(uuid())
  authId         String   @unique @map("auth_id")
  email          String   @unique
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  secondLastName String?  @map("second_last_name")
  avatarUrl           String?  @map("avatar_url")
  phone               String?
  currency            String   @default("MXN")
  locale              String   @default("es-MX")
  timezone            String   @default("America/Mexico_City")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  accounts          Account[]
  banks             Bank[]
  categories        Category[]
  budgets           Budget[]
  savingsGoals      SavingsGoal[]
  incomeSources     IncomeSource[]
  recurringExpenses RecurringExpense[]

  @@map("profiles")
}

// ─── Bank ─────────────────────────────────────────────────────────────
// Financial institution that groups accounts (BBVA, Citi, etc.)
// Cash accounts have bankId = null
model Bank {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  name      String
  color     String?
  logo      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile  Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([profileId])
  @@map("banks")
}

// ─── Income Source ───────────────────────────────────────────────────
enum IncomeFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model IncomeSource {
  id                  String          @id @default(uuid())
  profileId           String          @map("profile_id")
  name                String
  amount              Decimal         @db.Decimal(12, 2)
  frequency           IncomeFrequency
  paydays             Int[]
  destinationAccountId String          @map("destination_account_id")
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  profile            Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  destinationAccount Account @relation(fields: [destinationAccountId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("income_sources")
}

// ─── Account ─────────────────────────────────────────────────────────
enum AccountType {
  DEBIT
  CREDIT
  LOAN
  CASH
}

model Account {
  id        String      @id @default(uuid())
  profileId String      @map("profile_id")
  bankId    String?     @map("bank_id")
  name      String
  type      AccountType
  currency  String      @default("MXN")
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  color     String?
  icon      String?
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  profile             Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bank                Bank?          @relation(fields: [bankId], references: [id], onDelete: Cascade)
  transactions        Transaction[]  @relation("AccountTransactions")
  destinationTransactions Transaction[] @relation("DestinationTransactions")
  creditCard          CreditCard?
  loan                Loan?
  incomeSources       IncomeSource[]
  savingsGoals        SavingsGoal[]
  recurringExpenses   RecurringExpense[]

  @@index([profileId])
  @@index([bankId])
  @@map("accounts")
}

// ─── Transaction ─────────────────────────────────────────────────────
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  PAYMENT
}

model Transaction {
  id                  String          @id @default(uuid())
  accountId           String          @map("account_id")
  destinationAccountId String?         @map("destination_account_id")
  categoryId          String?         @map("category_id")
  type                TransactionType
  amount              Decimal         @db.Decimal(12, 2)
  description         String?
  note                String?
  date                DateTime        @default(now())
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Credit card reactive behavior: link to generated statement + commission typing
  statementId         String?         @map("statement_id")
  commissionType      CommissionType? @map("commission_type")

  account            Account   @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  destinationAccount Account?  @relation("DestinationTransactions", fields: [destinationAccountId], references: [id], onDelete: SetNull)
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  statement          CardStatement?    @relation(fields: [statementId], references: [id], onDelete: SetNull)
  installmentPlan    InstallmentPlan?

  @@index([accountId, date])
  @@index([destinationAccountId])
  @@index([categoryId])
  @@index([statementId])
  @@map("transactions")
}

// ─── Category ────────────────────────────────────────────────────────
enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id        String       @id @default(uuid())
  profileId String       @map("profile_id")
  name      String
  type      CategoryType
  color     String?
  icon      String?
  createdAt DateTime     @default(now()) @map("created_at")

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurringExpenses RecurringExpense[]

  @@unique([profileId, name, type])
  @@map("categories")
}

// ─── Budget ──────────────────────────────────────────────────────────
enum BudgetPeriod {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model Budget {
  id         String       @id @default(uuid())
  profileId  String       @map("profile_id")
  categoryId String       @map("category_id")
  amount     Decimal      @db.Decimal(12, 2)
  period     BudgetPeriod @default(MONTHLY)
  startDate  DateTime     @map("start_date")
  endDate    DateTime?    @map("end_date")
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

// ─── Savings Goal ────────────────────────────────────────────────────
model SavingsGoal {
  id           String    @id @default(uuid())
  profileId    String    @map("profile_id")
  accountId    String    @map("account_id")
  name         String
  targetAmount Decimal   @map("target_amount") @db.Decimal(12, 2)
  deadline     DateTime?
  color        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("savings_goals")
}

// ─── Credit Card ─────────────────────────────────────────────────────
model CreditCard {
  id               String   @id @default(uuid())
  accountId        String   @unique @map("account_id")
  creditLimit      Decimal  @map("credit_limit") @db.Decimal(12, 2)
  cutDay           Int      @map("cut_day") // 1-31
  interestRate     Decimal  @map("interest_rate") @db.Decimal(5, 4) // annual rate as decimal (e.g. 0.3600 = 36%)
  noInterestMonths Int      @default(0) @map("no_interest_months")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Credit card reactive behavior: payment due days (offset from cut day) replaces fixed paymentDay
  paymentDueDays     Int?    @default(20) @map("payment_due_days")
  // Tolerance for over-limit spending (default 0 = strict limit)
  overLimitTolerance Decimal  @default(0) @map("over_limit_tolerance") @db.Decimal(12, 2)
  // Deprecated: replaced by paymentDueDays. Kept nullable for backward compatibility during transition.
  paymentDay         Int?    @map("payment_day") // 1-31

  account    Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  statements CardStatement[]

  @@map("credit_cards")
}

// ─── Card Statement ──────────────────────────────────────────────────
model CardStatement {
  id                String   @id @default(uuid())
  creditCardId      String   @map("credit_card_id")
  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")
  balance           Decimal  @db.Decimal(12, 2)
  minPayment        Decimal  @map("min_payment") @db.Decimal(12, 2)
  noInterestPayment Decimal  @map("no_interest_payment") @db.Decimal(12, 2)
  interestAmount    Decimal  @default(0) @map("interest_amount") @db.Decimal(12, 2)
  isPaid            Boolean  @default(false) @map("is_paid")
  createdAt         DateTime @default(now()) @map("created_at")

  // Credit card reactive behavior: payment tracking + generation metadata
  paymentDueDate   DateTime? @map("payment_due_date")
  paidAmount       Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingBalance Decimal?  @map("remaining_balance") @db.Decimal(12, 2)
  isGenerated      Boolean   @default(false) @map("is_generated")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  creditCard   CreditCard   @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([creditCardId, periodStart])
  @@index([creditCardId, periodEnd])
  @@map("card_statements")
}

// ─── Installment Plan ─────────────────────────────────────────────────
// Per-transaction installment tracking for MSI (sin intereses) and MSCI (con intereses)
model InstallmentPlan {
  id            String                @id @default(uuid())
  transactionId String                @unique @map("transaction_id")
  type          InstallmentPlanType
  totalMonths   Int                   @map("total_months")
  currentMonth  Int                   @default(0) @map("current_month")
  monthlyAmount Decimal               @map("monthly_amount") @db.Decimal(12, 2)
  // null for MSI, non-null for MSCI (per-plan interest rate)
  interestRate  Decimal?              @map("interest_rate") @db.Decimal(5, 4)
  status        InstallmentPlanStatus @default(ACTIVE)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("installment_plans")
}

// ─── Loan ────────────────────────────────────────────────────────────
model Loan {
  id             String   @id @default(uuid())
  accountId      String   @unique @map("account_id")
  principal      Decimal  @db.Decimal(12, 2)
  interestRate   Decimal  @map("interest_rate") @db.Decimal(5, 4) // annual rate as decimal
  termMonths     Int      @map("term_months")
  startDate      DateTime @map("start_date")
  monthlyPayment Decimal  @map("monthly_payment") @db.Decimal(12, 2)
  remaining      Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("loans")
}

// ─── Credit Card Reactive Behavior Enums ───────────────────────────────
// Commission types for typed EXPENSE transactions (commissions as transactions)
enum CommissionType {
  ANNUAL_FEE
  LATE_PAYMENT
  CASH_ADVANCE
  INTEREST_CHARGE
}

// Installment plan types: MSI (sin intereses), MSCI (con intereses)
enum InstallmentPlanType {
  MSI
  MSCI
}

// Installment plan lifecycle states
enum InstallmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── Recurring Expense ───────────────────────────────────────────────
// Recurring expense definition (subscriptions, services, rent, etc.)
// Mirror of IncomeSource but for expenses. Generates EXPENSE transactions
// on billing days when the reactive behavior is implemented.
enum RecurringExpenseType {
  SUBSCRIPTION
  SERVICE
  UNCLASSIFIED
}

enum RecurringExpenseFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model RecurringExpense {
  id          String                   @id @default(uuid())
  profileId   String                   @map("profile_id")
  name        String
  amount      Decimal                  @db.Decimal(12, 2)
  frequency   RecurringExpenseFrequency
  billingDays Int[]                    @map("billing_days")
  type        RecurringExpenseType     @default(UNCLASSIFIED)
  accountId   String                   @map("account_id")
  categoryId  String?                  @map("category_id")
  url         String?
  color       String?
  icon        String?
  isActive    Boolean                  @default(true) @map("is_active")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  profile  Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account  Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([accountId])
  @@map("recurring_expenses")
}